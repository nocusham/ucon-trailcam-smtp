# Lokale Passwortdatei: als .env kopieren, chmod 600, dann lokal bearbeiten.
# UTF-8, eine Zeile NAME=Wert. Kein export, keine Shell-Auswertung, keine Anführungszeichen.
# Alles nach dem ersten = ist der Wert, auch #, $, weitere =, Leerzeichen und Anführungszeichen.
# Kommentare nur auf eigenen Zeilen. .env nicht mit source laden und nicht veröffentlichen.

# Ucon-Konto (E-Mail-Adresse bzw. Kontoname):
UCON_ACCOUNT=

# Ucon-Passwort:
UCON_PASSWORD=

# Privates SMTP-Passwort; Name muss zu password_env in config.local.toml passen:
SMTP_PASSWORD=

# Weitere separate SMTP-Passwörter bei Bedarf:
# SMTP_PASSWORD_KAMERA2=
# SMTP_PASSWORD_KAMERA3=
