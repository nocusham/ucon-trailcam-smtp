# Local credential file: copy to .env, set mode 600, then edit privately.
# UTF-8, one NAME=value per line. No export, shell expansion or quoting syntax.
# Everything after the first = is literal, including #, $, =, spaces and quotes.
# Comments occupy their own lines. Never source or publish the .env file.

# Ucon account (email address or account name):
UCON_ACCOUNT=

# Ucon password:
UCON_PASSWORD=

# Private SMTP password; the key must match password_env in config.local.toml:
SMTP_PASSWORD=

# Additional separate SMTP passwords when needed:
# SMTP_PASSWORD_KAMERA2=
# SMTP_PASSWORD_KAMERA3=

# Optional password for the independent alert account (alerts.smtp.password_env):
# ALERT_SMTP_PASSWORD=
